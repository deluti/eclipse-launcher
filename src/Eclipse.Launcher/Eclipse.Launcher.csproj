<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Eclipse</AssemblyName>
    <RootNamespace>Eclipse</RootNamespace>
    <Version>0.4.0</Version>
    <Product>Eclipse Launcher</Product>
    <Company>deluti</Company>
    <Description>Fast Minecraft Java Edition launcher</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Eclipse.ico</ApplicationIcon>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>
  <ItemGroup><None Include="launcher-config.json" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\en.json" />
    <EmbeddedResource Include="Assets\Monocraft.ttf" />
    <EmbeddedResource Include="Assets\steve.png" />
    <EmbeddedResource Include="Assets\Eclipse.ico" />
    <None Include="Assets\Monocraft-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
